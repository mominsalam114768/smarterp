rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner() {
      return isSignedIn() &&
             request.auth.token != null &&
             request.auth.token.admin == true;
    }

    // Check if super admin (admins collection lookup, custom admin claim, or isSuperAdmin profile flag)
    function isAdmin() {
      return isSignedIn() && (
        isOwner() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isSuperAdmin', false) == true)
      );
    }

    // Check if user belongs to the business
    function isBusinessUser(businessId) {
      return !isSignedIn() ||
             (isSignedIn() && (
               isAdmin() ||
               !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == businessId
             ));
    }

    // Check if user is business admin (owner or superadmin or has 'admin' role in business)
    function isBusinessAdmin(businessId) {
      return !isSignedIn() ||
             (isSignedIn() && (
               isAdmin() ||
               !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
               (
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == businessId &&
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
               )
             ));
    }

    // --- Entity Validations ---

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.salePrice is number && data.salePrice >= 0 &&
             data.stock is number &&
             (!('bnName' in data) || data.bnName is string) &&
             (!('sku' in data) || data.sku is string) &&
             (!('barcode' in data) || data.barcode is string) &&
             (!('barcodes' in data) || data.barcodes is list) &&
             (!('categoryId' in data) || data.categoryId is string) &&
             (!('brandId' in data) || data.brandId is string) &&
             (!('unit' in data) || data.unit is string) &&
             (!('purchasePrice' in data) || data.purchasePrice is number) &&
             (!('minStock' in data) || data.minStock is number) &&
             (!('expiryDate' in data) || data.expiryDate is string) &&
             (!('image' in data) || data.image is string) &&
             (!('isCustomProduct' in data) || data.isCustomProduct is bool) &&
             (!('createdAt' in data) || data.createdAt is string);
    }

    function isValidCustomer(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 20 &&
             (!('email' in data) || data.email is string) &&
             (!('address' in data) || data.address is string) &&
             (!('image' in data) || data.image is string) &&
             (!('dueAmount' in data) || data.dueAmount is number) &&
             (!('totalSpent' in data) || data.totalSpent is number) &&
             (!('createdBy' in data) || data.createdBy is string) &&
             (!('createdAt' in data) || data.createdAt is string);
    }

    function isValidSale(data) {
      return data.totalAmount is number && data.totalAmount >= 0 &&
             data.paidAmount is number && data.paidAmount >= 0 &&
             (!('customerId' in data) || data.customerId is string) &&
             (!('customerName' in data) || data.customerName is string) &&
             (!('customerPhone' in data) || data.customerPhone is string) &&
             (!('customerAddress' in data) || data.customerAddress is string) &&
             (!('userId' in data) || data.userId is string) &&
             (!('invoiceNo' in data) || data.invoiceNo is string) &&
             (!('dueAmount' in data) || data.dueAmount is number) &&
             (!('payableAmount' in data) || data.payableAmount is number) &&
             (!('discount' in data) || data.discount is number) &&
             (!('vat' in data) || data.vat is number) &&
             (!('paymentMethod' in data) || data.paymentMethod is string) &&
             (!('items' in data) || (data.items is list && (data.items.size() == 0 || data.items[0] is map))) &&
             (!('createdBy' in data) || data.createdBy is string) &&
             (!('createdAt' in data) || data.createdAt is string) &&
             (!('isTemporary' in data) || data.isTemporary is bool) &&
             (!('approvalStatus' in data) || data.approvalStatus in ['pending', 'approved', 'rejected']) &&
             (!('approvalRequestId' in data) || data.approvalRequestId is string);
    }

    function isValidUser(data) {
      return (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('role' in data) || data.role in ['admin', 'super_admin', 'manager', 'salesman', 'accountant', 'staff']) &&
             (!('businessId' in data) || (data.businessId is string && data.businessId.size() <= 128)) &&
             (!('isSuperAdmin' in data) || data.isSuperAdmin is bool) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
             (!('password' in data) || data.password == null || (data.password is string && data.password.size() <= 128) || data.password is map) &&
             (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 256)) &&
             (!('passwordSalt' in data) || (data.passwordSalt is string && data.passwordSalt.size() <= 256)) &&
             (!('image' in data) || (data.image is string && data.image.size() <= 500000)) &&
             (!('permissions' in data) || (data.permissions is list && data.permissions.size() <= 50)) &&
             (!('lastSeen' in data) || data.lastSeen is string) &&
             (!('lastActive' in data) || data.lastActive is string) &&
             (!('createdAt' in data) || data.createdAt is string);
    }

    function isValidApprovalRequest(data) {
      return data.type in ['sale', 'due_payment'] &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             (!('userName' in data) || (data.userName is string && data.userName.size() <= 100)) &&
             (!('temporaryInvoiceNo' in data) || (data.temporaryInvoiceNo is string && data.temporaryInvoiceNo.size() <= 64)) &&
             (!('createdAt' in data) || data.createdAt is string);
    }

    // Expenses subcollection validation
    function isValidExpense(data) {
      return data.category is string && data.amount is number && data.amount >= 0 &&
             (!('description' in data) || data.description is string) &&
             (!('note' in data) || data.note is string) &&
             (!('date' in data) || data.date is string) &&
             (!('userId' in data) || data.userId is string);
    }

    function isValidSupplier(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('phone' in data) || data.phone is string) &&
             (!('address' in data) || data.address is string) &&
             (!('company' in data) || data.company is string) &&
             (!('dueAmount' in data) || data.dueAmount is number);
    }

    function isValidBusiness(data) {
      return (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 100)) &&
             (!('id' in data) || data.id is string) &&
             (!('address' in data) || data.address is string) &&
             (!('phone' in data) || data.phone is string) &&
             (!('currency' in data) || data.currency is string) &&
             (!('logo' in data) || data.logo is string) &&
             (!('logoUrl' in data) || data.logoUrl is string) &&
             (!('backupEmail' in data) || data.backupEmail is string) &&
             (!('defaultPrinter' in data) || data.defaultPrinter is string) &&
             (!('theme' in data) || data.theme is string) &&
             (!('createdAt' in data) || data.createdAt is string) &&
             (!('smtpConfig' in data) || data.smtpConfig is map) &&
             (!('googleSheetsConfig' in data) || data.googleSheetsConfig is map);
    }

    // --- Match Rules ---

    // 1. User Profiles - Publicly readable for unauthenticated login lookup, but restricted on writes
    match /users/{userId} {
      allow get: if true; // Required for login lookups by email
      allow list: if true; // Required for unauthenticated email-based queries during login

      allow create: if isValidUser(incoming()) && isValidId(userId) && (
        isAdmin() ||
        (userId == 'admin-1' && !exists(/databases/$(database)/documents/users/admin-1)) ||
        (!isSignedIn() && !exists(/databases/$(database)/documents/users/$(userId)) && incoming().get('isSuperAdmin', false) == false) ||
        (incoming().get('role', 'salesman') != 'admin' && !exists(/databases/$(database)/documents/users/$(userId)) && incoming().get('isSuperAdmin', false) == false)
      );

      allow update: if isValidUser(incoming()) && (
        isAdmin() ||
        isBusinessAdmin(existing().get('businessId', 'main-business')) ||
        (
          incoming().get('role', 'salesman') == existing().get('role', 'salesman') &&
          incoming().get('businessId', 'main-business') == existing().get('businessId', 'main-business') &&
          incoming().get('isSuperAdmin', false) == existing().get('isSuperAdmin', false)
        )
      );

      allow delete: if isBusinessAdmin('main-business') && userId != 'admin-1';
    }

    // 2. Business Data and Subcollections
    match /businesses/{businessId} {
      allow get, list: if true; // Allows loading of business details (name, currency, logo)
      allow create: if isBusinessAdmin(businessId) && isValidBusiness(incoming());
      allow update: if isBusinessAdmin(businessId) && isValidBusiness(incoming());
      allow delete: if isBusinessAdmin(businessId);

      // Products subcollection
      match /products/{productId} {
        allow read: if isBusinessUser(businessId);
        allow create: if isBusinessUser(businessId) && isValidProduct(incoming()) && isValidId(productId);
        allow update: if isBusinessUser(businessId) && isValidProduct(incoming()) && (
          isBusinessAdmin(businessId) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'barcodes'])
        );
        allow delete: if isBusinessAdmin(businessId);
      }

      // Categories subcollection
      match /categories/{catId} {
        allow read, write: if isBusinessUser(businessId);
      }

      // Customers subcollection and sub-payments
      match /customers/{customerId} {
        allow read: if isBusinessUser(businessId);
        allow create: if isBusinessUser(businessId) && isValidCustomer(incoming()) && isValidId(customerId);
        allow update: if isBusinessUser(businessId) && isValidCustomer(incoming()) && (
          isBusinessAdmin(businessId) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['dueAmount', 'totalSpent'])
        );
        allow delete: if isBusinessAdmin(businessId);
        
        match /payments/{paymentId} {
          allow read, write: if isBusinessUser(businessId);
        }
      }

      // Sales subcollection
      match /sales/{saleId} {
        allow read: if isBusinessUser(businessId);
        allow create: if isBusinessUser(businessId) && isValidSale(incoming()) && isValidId(saleId);
        allow update: if isBusinessUser(businessId) && isValidSale(incoming()) && (
          isBusinessAdmin(businessId) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['paidAmount', 'dueAmount', 'approvalStatus', 'isTemporary', 'approvalRequestId'])
        );
        allow delete: if isBusinessAdmin(businessId);
      }

      // Approval Requests subcollection (Sales Orders / Due Payment Requests)
      match /approval_requests/{requestId} {
        allow read: if isBusinessUser(businessId);
        allow create: if isBusinessUser(businessId) && isValidApprovalRequest(incoming()) && isValidId(requestId);
        allow update: if isBusinessUser(businessId) && isValidApprovalRequest(incoming());
        allow delete: if isBusinessAdmin(businessId);
      }

      // Expenses subcollection
      match /expenses/{expenseId} {
        allow read: if isBusinessUser(businessId);
        allow create: if isBusinessUser(businessId) && isValidExpense(incoming()) && isValidId(expenseId);
        allow update: if isBusinessUser(businessId) && isValidExpense(incoming()) && isBusinessAdmin(businessId);
        allow delete: if isBusinessAdmin(businessId);
      }

      // Suppliers subcollection and sub-transactions
      match /suppliers/{supplierId} {
        allow read: if isBusinessUser(businessId);
        allow create: if isBusinessUser(businessId) && isValidSupplier(incoming()) && isValidId(supplierId);
        allow update: if isBusinessUser(businessId) && isValidSupplier(incoming()) && (
          isBusinessAdmin(businessId) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['dueAmount'])
        );
        allow delete: if isBusinessAdmin(businessId);

        match /transactions/{tId} {
          allow read, write: if isBusinessUser(businessId);
        }
      }

      // SMS logs subcollection
      match /sms_logs/{logId} {
        allow read: if isBusinessUser(businessId);
        allow create: if isBusinessUser(businessId) && isValidId(logId);
      }

      // Configuration subcollection
      match /config/{configId} {
        allow read, write: if isBusinessUser(businessId);
      }
    }

    // 3. Super Admins
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable through GCP console
    }
    
    // 4. Fallback/aggregate errors tracking path if any
    match /dashboard_aggregate/{docId} {
      allow read: if isBusinessUser('main-business');
      allow write: if isBusinessUser('main-business');
    }
  }
}
