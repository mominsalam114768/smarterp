# Frontend Firebase & Google OAuth Configuration (override firebase-applet-config.json in production / Cloudflare Pages)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Anti-Cloning & Domain Allowlist (Comma-separated allowed hostnames, e.g., smarterp-5y9.pages.dev,yourdomain.com)
VITE_ALLOWED_DOMAINS=

# Backend Firebase Admin Config
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=

# Database Backup SMTP Config
SMTP_USER=
SMTP_PASS=

# Server & Encryption Secrets (Set strong random strings in production)
BACKUP_SECRET=
AUTH_TOKEN_SECRET=
WORKER_API_SECRET=
ALLOWED_ORIGIN=

